APPS_JSON=/workspace/.config/apps.json
# Optional: enable one shared Bench with multiple isolated sites.
# SITES_JSON=/workspace/.config/sites.json
ADMIN_PASSWORD=1212
BACKUP_URL=
SOURCE_SITE_URL=

# Optional SSH path overrides for non-standard host setups. VS Code Dev
# Containers forwards the local agent automatically on supported platforms.
# HOST_SSH_DIR=/absolute/path/to/.ssh
# HOST_SSH_AUTH_SOCK=/absolute/path/to/ssh-agent.sock

# Optional when the host Codex state directory is not ~/.codex.
# HOST_CODEX_HOME=/absolute/path/to/.codex

# Optional when the host OpenCode directories are not the XDG defaults.
# HOST_OPENCODE_CONFIG_HOME=/absolute/path/to/.config/opencode
# HOST_OPENCODE_DATA_HOME=/absolute/path/to/.local/share/opencode
# HOST_OPENCODE_CACHE_HOME=/absolute/path/to/.cache/opencode
# HOST_OPENCODE_STATE_HOME=/absolute/path/to/.local/state/opencode

# Optional: authenticate the bridged GitHub CLI inside the container. Generate a
# token on the host with `gh auth token` and paste it here. The file is ignored.
# GH_TOKEN=gho_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional when the host GitHub CLI directory is not ~/.local/gh.
# HOST_GH_HOME=/absolute/path/to/.local/gh
